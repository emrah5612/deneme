import json
import os
import requests
from bs4 import BeautifulSoup
from datetime import datetime
import urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

class OklahomaScraper:
    def __init__(self):
        self.state_name = "Oklahoma"
        self.state_code = "OK"
        self.session = requests.Session()
        self.session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Referer": "https://craigcountyso.com/"
        })

    def scrape_craig_county(self):
        url = "https://craigcountyso.com/inmate-search"
        print(f"[*] Craig County (OK) mahkum listesi cekiliyor: {url}")
        
        inmates = []
        try:
            response = self.session.get(url, timeout=25, verify=False)
            print(f"[*] Yanıt Kodu: {response.status_code}")
            
            if response.status_code == 200:
                soup = BeautifulSoup(response.text, "html.parser")
                
                # Tüm tablo ve kart yapılarını tara
                cards = soup.find_all(lambda tag: tag.name in ["tr", "div", "li"] and ("inmate" in tag.get("class", []) or "row" in tag.get("class", [])))
                
                for item in soup.find_all(["tr", "div"]):
                    text = item.get_text(separator=" | ", strip=True)
                    if "In Custody" in text or "Aug" in text or "26-" in text:
                        parts = [p.strip() for p in text.split("|") if p.strip()]
                        if len(parts) >= 3 and parts not in [i.get("raw") for i in inmates]:
                            inmates.append({
                                "name": parts[0] if len(parts) > 0 else "Unknown",
                                "booking_no": parts[1] if len(parts) > 1 else "",
                                "booking_date": parts[2] if len(parts) > 2 else "",
                                "raw_details": parts
                            })

                # Eğer özel bir liste yakalanamazsa sayfa içeriğini özet olarak al
                if not inmates:
                    inmates.append({
                        "status": "Siteye erisildi ancak liste yapisi ayristirilamadi",
                        "html_length": len(response.text)
                    })

        except Exception as e:
            print(f"[!] Hata olustu: {e}")
            inmates.append({"error": str(e)})

        return inmates

    def run(self):
        print(f"[*] {self.state_name} eyaleti baslatildi...")
        craig_inmates = self.scrape_craig_county()

        output = {
            "state": self.state_name,
            "state_code": self.state_code,
            "county": "Craig County",
            "source_url": "https://craigcountyso.com/inmate-search",
            "last_updated": datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC"),
            "total_inmates": len(craig_inmates),
            "inmates": craig_inmates
        }

        os.makedirs("data", exist_ok=True)
        file_path = os.path.join("data", "oklahoma_craig.json")
        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(output, f, indent=2, ensure_ascii=False)

        print(f"[✓] Kayit tamamlandi: {file_path}")
